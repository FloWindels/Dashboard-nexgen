# /etc/sudoers.d/hyperflo-control  (root:root, mode 0440)
# Toujours valider avec: visudo -cf <fichier>
# (sudo-rs: env_reset est toujours actif)
#
# Le service n'a acces qu'a ces scripts. Ceux qui prennent des arguments
# valident eux-memes l'action et le nom du conteneur. "" interdit tout
# argument a hyperflo-docker-list et hyperflo-docker-stats; le script
# Minecraft n'accepte que start, stop ou restart.

hyperflo ALL=(root) NOPASSWD: /usr/local/sbin/hyperflo-docker-list "", /usr/local/sbin/hyperflo-docker-stats "", /usr/local/sbin/hyperflo-docker-action, /usr/local/sbin/hyperflo-docker-info, /usr/local/sbin/hyperflo-minecraft-action start, /usr/local/sbin/hyperflo-minecraft-action stop, /usr/local/sbin/hyperflo-minecraft-action restart
