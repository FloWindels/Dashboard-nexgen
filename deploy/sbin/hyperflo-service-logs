#!/usr/bin/python3 -I

# Derniers logs journald d'une liste fermee de services.
#
#   hyperflo-service-logs <source> <lignes>
#
# Remplace l'ajout du compte hyperflo au groupe systemd-journal, qui lui
# donnerait acces a tout le journal (authentifications, sudo...).

import subprocess
import sys

SOURCES = {
    "hyperflo": "hyperflo-control.service",
    "playit": "playit.service",
    "cloudflared": "cloudflared.service",
    "ssh": "ssh.service",
    "docker": "docker.service",
}


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


if len(sys.argv) != 3:
    fail("Usage: hyperflo-service-logs <source> <lignes>")

source = sys.argv[1]
if source not in SOURCES:
    fail("Source non autorisee")

try:
    lines = int(sys.argv[2])
except ValueError:
    fail("Nombre de lignes invalide")
lines = max(1, min(lines, 1000))

try:
    result = subprocess.run(
        [
            "/usr/bin/journalctl",
            "--unit", SOURCES[source],
            "--lines", str(lines),
            "--no-pager",
            "--output", "short-iso",
        ],
        capture_output=True,
        text=True,
        timeout=20,
        check=False,
    )
except subprocess.TimeoutExpired:
    fail("Delai depasse")

if result.returncode != 0:
    fail(result.stderr.strip() or "journalctl a echoue")

print(result.stdout, end="")
