#!/usr/bin/python3 -I

import re
import subprocess
import sys


ALLOWED_ACTIONS = {
    "start",
    "stop",
    "restart"
}

NAME_PATTERN = re.compile(
    r"^[A-Za-z0-9][A-Za-z0-9_.-]{0,127}$"
)


def fail(message):
    print(message, file=sys.stderr)
    sys.exit(1)


if len(sys.argv) != 3:
    fail("Usage: hyperflo-docker-action <action> <container>")


action = sys.argv[1]
container = sys.argv[2]


if action not in ALLOWED_ACTIONS:
    fail("Action non autorisee")


if not NAME_PATTERN.fullmatch(container):
    fail("Nom de conteneur invalide")


# Minecraft passe par hyperflo-minecraft-action (Playit + arret de 90 s
# pour laisser le temps de sauvegarder le monde).
if container == "minecraft":
    fail("Utiliser hyperflo-minecraft-action pour minecraft")


inspect = subprocess.run(
    [
        "/usr/bin/docker",
        "inspect",
        "--type",
        "container",
        container
    ],
    stdout=subprocess.DEVNULL,
    stderr=subprocess.DEVNULL
)

if inspect.returncode != 0:
    fail("Conteneur inexistant")


if action == "restart":
    command = [
        "/usr/bin/docker",
        "restart",
        "--time",
        "10",
        container
    ]

elif action == "stop":
    command = [
        "/usr/bin/docker",
        "stop",
        "--time",
        "10",
        container
    ]

else:
    command = [
        "/usr/bin/docker",
        "start",
        container
    ]


result = subprocess.run(
    command,
    capture_output=True,
    text=True,
    timeout=30
)


if result.returncode != 0:
    fail(result.stderr.strip() or "Docker action failed")


subprocess.run(
    [
        "/usr/bin/logger",
        "-t",
        "hyperflo-control",
        f"docker {action} {container}"
    ]
)


print(result.stdout.strip())
